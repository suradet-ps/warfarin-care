{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "files": {
    "includes": ["src/**/*.ts", "src/**/*.vue", "src/**/*.js", "*.ts", "*.js", "*.json"],
    "ignoreUnknown": false
  },
  "overrides": [
    {
      "includes": ["src/warfarin_logic/**"],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off",
            "noMagicNumbers": "off"
          },
          "correctness": {
            "useHookAtTopLevel": "off",
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    }
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "all",
      "style": {
        "noMagicNumbers": "warn",
        "useNamingConvention": "off",
        "noTernary": "off",
        "noContinue": "off",
        "noDefaultExport": "off",
        "useGlobalThis": "off",
        "noIncrementDecrement": "off",
        "useBlockStatements": "warn",
        "useDestructuring": "warn",
        "useExportsLast": "off",
        "noNestedTernary": "off",
        "noExcessiveLinesPerFile": "warn"
      },
      "complexity": {
        "noVoid": "off",
        "noExcessiveCognitiveComplexity": "warn",
        "noExcessiveLinesPerFunction": "warn",
        "useMaxParams": "warn"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn",
        "useQwikValidLexicalScope": "off",
        "noUnresolvedImports": "warn"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noAlert": "off",
        "noEmptyBlockStatements": "warn",
        "noUnnecessaryConditions": "warn",
        "useAwait": "warn"
      },
      "performance": {
        "useTopLevelRegex": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  }
}
